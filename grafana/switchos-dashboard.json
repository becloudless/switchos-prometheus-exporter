        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 302,
