        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(switchos_stats_rx_errors_total{host=~\"$host\"}[5m])", "legendFormat": "{{host}} rx errors port {{port}}", "refId": "C" }
      ],
